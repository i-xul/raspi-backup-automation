[Unit]
Description=Ubuntu Desktop Restic Retention
Documentation=https://github.com/i-xul/raspi-backup-automation
Wants=network-online.target
After=network-online.target ubuntu-desktop-backup.service

ConditionPathIsMountPoint=/mnt/nas-backups

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ubuntu-desktop-retention

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

User=root
Group=root
